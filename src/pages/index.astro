---
import Base from '../layouts/Base.astro';
import Quiz from '../components/Quiz.svelte';
import { SITE } from '../data/site';
import { carregarConteudo } from '../lib/conteudo';

// Tudo aqui é público (o repositório também é): posições e fontes vão no bundle
// para o cálculo rodar no navegador, sem nenhuma requisição ao servidor.
const { afirmacoes, candidatos } = await carregarConteudo();
---

<Base>
  <Quiz {afirmacoes} {candidatos} endereco={SITE.url} client:load />
</Base>
