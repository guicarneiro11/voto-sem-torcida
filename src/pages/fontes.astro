---
import Base from '../layouts/Base.astro';
import { carregarConteudo } from '../lib/conteudo';
import { ROTULO_POSICAO, ROTULO_TEMA, rotuloFonte } from '../lib/rotulos';

const { afirmacoes, candidatos } = await carregarConteudo();
const ordenadas = [...afirmacoes].sort((a, b) => a.tema.localeCompare(b.tema));
---

<Base
  title="Fontes"
  description="Todas as afirmações do quiz, com a posição de cada candidato e a fonte."
>
  <article>
    <p class="text-sm font-semibold tracking-wide text-acento uppercase">Transparência</p>
    <h1 class="mt-3 text-4xl leading-tight font-semibold">Afirmações, posições e fontes</h1>
    <p class="mt-4 leading-relaxed text-suave">
      Esta página mostra de quem é cada posição. Se você ainda não fez o quiz,{' '}
      <a class="text-acento underline" href="/">
        faça antes
      </a>{' '}
      para responder sem saber.
    </p>

    <ul class="mt-10 space-y-6">
      {ordenadas.map((a) => (
        <li class="rounded-xl border border-linha bg-cartao p-6">
          <p class="text-sm text-suave">{ROTULO_TEMA[a.tema] ?? a.tema}</p>
          <h2 class="mt-1 text-xl leading-snug font-semibold">{a.titulo}</h2>
          <p class="mt-3 text-sm leading-relaxed text-suave">{a.explicacao}</p>
          <dl class="mt-4 grid gap-3 sm:grid-cols-2">
            {candidatos.map((c) => {
              const p = a.posicoes[c.id];
              return (
                <div class="rounded-lg bg-papel p-4 text-sm">
                  <dt class="font-semibold">{c.nome}</dt>
                  <dd class="mt-1">{p ? ROTULO_POSICAO[p.valor] : ROTULO_POSICAO.sem_posicao}</dd>
                  {(p?.fontes ?? []).map((f) => (
                    <dd class="mt-1">
                      <a
                        class="text-acento underline"
                        href={f.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {rotuloFonte(f)}
                      </a>
                    </dd>
                  ))}
                </div>
              );
            })}
          </dl>
        </li>
      ))}
    </ul>
  </article>
</Base>
