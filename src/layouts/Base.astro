---
import '../styles/global.css';
import { SITE, VERSAO } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.descricao } = Astro.props;
const tituloCompleto = title ? `${title} · ${SITE.nome}` : `${SITE.nome}: propostas sem torcida`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const imagemOg = new URL('/og.png', Astro.site ?? SITE.url).toString();
const atual = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', rotulo: 'Quiz' },
  { href: '/metodologia', rotulo: 'Metodologia' },
  { href: '/fontes', rotulo: 'Fontes' },
  { href: '/sobre', rotulo: 'Sobre' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6f3ec" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagemOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-dvh flex-col bg-papel text-tinta antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded focus:bg-tinta focus:px-3 focus:py-2 focus:text-papel"
    >
      Pular para o conteúdo
    </a>

    <header class="border-b border-linha">
      <nav
        class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-4"
        aria-label="Principal"
      >
        <a href="/" class="font-display text-xl font-semibold tracking-tight">
          {SITE.nome}
        </a>
        <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[
                  'hover:underline',
                  atual === l.href ? 'font-semibold text-acento' : 'text-suave',
                ]}
                aria-current={atual === l.href ? 'page' : undefined}
              >
                {l.rotulo}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="conteudo" class="mx-auto w-full max-w-3xl flex-1 px-5 py-10">
      <slot />
    </main>

    <footer class="border-t border-linha text-sm text-suave">
      <div class="mx-auto flex max-w-3xl flex-col gap-3 px-5 py-8">
        <p>
          Projeto independente, sem ligação com partidos, candidaturas ou campanhas. Não é pesquisa
          eleitoral nem recomendação de voto.
        </p>
        <p class="flex flex-wrap gap-x-4 gap-y-1">
          <a class="underline" href="/privacidade">
            Privacidade
          </a>
          <a class="underline" href="/metodologia">
            Como funciona
          </a>
          <a class="underline" href={SITE.repositorio} rel="noopener noreferrer">
            Código aberto
          </a>
          <span>
            Versão publicada: <code>{VERSAO}</code>
          </span>
        </p>
      </div>
    </footer>
  </body>
</html>
